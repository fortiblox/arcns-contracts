# Foundry build artifacts
out/
cache/
# Local broadcast logs (testnet/mainnet broadcasts are committed deliberately under deployments/)
broadcast/*/31337/
broadcast/**/dry-run/
# Local env (names-only .env.example is committed)
.env
.env.*
!.env.example
# Fork rehearsals of DeployAll (ARCNS_DRY_RUN=1) — the live address book is deployments/<chainId>.json
deployments/*.dry-run.json
# forge script broadcast logs are never committed; the address book is deployments/<chainId>.json
broadcast/
