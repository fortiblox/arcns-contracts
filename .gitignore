# Foundry build artifacts
out/
cache/
# Local broadcast logs (testnet/mainnet broadcasts are committed deliberately under deployments/)
broadcast/*/31337/
broadcast/**/dry-run/
# Local env (names-only .env.example is committed)
.env
.env.*
!.env.example
# Fork rehearsals of DeployAll (ARCNS_DRY_RUN=1) — the live address book is deployments/<chainId>.json
deployments/*.dry-run.json
# Market phase-1 rehearsal output (DeployMarket without --broadcast); the live run appends .market to the book instead.
# deployments/<chainId>.market-grant.json (phase 2) is deterministic and IS committed: the reviewed governance payload.
deployments/*.market-dry-run.json
# WP #7772 rehearsal output (DeployControllerV2 without --broadcast); the live run appends .controllerV2 instead.
deployments/*.controllerV2-dry-run.json
# WP #7772 corrected-cutover payload (GrantControllerV2.s.sol). Unlike deployments/<chainId>.market-grant.json
# this is NOT committed as of this PR: it depends on a live .controllerV2 (DeployControllerV2 has not
# broadcast yet, CEO discretion — see deploy/runbooks/integrator-v2-cutover.md §3/§4) and its addresses
# change with every deploy. Once V2 is deployed live, regenerate and paste/commit it for CEO review on the
# WP #7772 thread, same discipline as the market-grant.json precedent.
deployments/*.controllerV2-cutover.json
# forge script broadcast logs are never committed; the address book is deployments/<chainId>.json
broadcast/
