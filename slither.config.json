{
  "detectors_to_exclude": "",
  "filter_paths": "lib/|test/|script/",
  "exclude_informational": false,
  "exclude_low": false,
  "exclude_optimization": true,
  "fail_on": "medium",
  "solc_remaps": [
    "@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/",
    "forge-std/=lib/forge-std/src/",
    "@ensdomains/ens-contracts/=lib/ens-contracts/contracts/",
    "lib/ens-contracts/:@openzeppelin/contracts/=lib/openzeppelin-contracts-v4/contracts/",
    "lib/ens-contracts/:@openzeppelin/contracts-v5/=lib/openzeppelin-contracts-v5.1/contracts/"
  ],
  "foundry_compile_all": false
}
