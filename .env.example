# contracts/.env.example — variable NAMES only (SR-80). Never put a value after `=` in this file.
# Real values live in /opt/arcns/.env (0600) or Forgejo repo secrets; consumers fail fast:
#   forge test --match-path 'test/fork/*' --rpc-url "${ARC_RPC_URL:?required}"
#   forge script ... --rpc-url "${ARC_RPC_URL:?required}" --etherscan-api-key "${ARCSCAN_API_KEY:?required}"
# Fork tests skip (printing FORK_SKIPPED) when ARC_RPC_URL is unset; CI sets it from a secret (WP-506).

# Arc testnet JSON-RPC (chain id 5042002), e.g. the public https://rpc.testnet.arc.io
ARC_RPC_URL=
# Any non-empty string for the self-hosted Blockscout at testnet.arcscan.app (forge verify-contract)
ARCSCAN_API_KEY=

# ---- deploy (script/DeployAll.s.sol) — all required, no defaults (WP-113)
# Owner of the Admin Safe (sole owner on testnet: the CEO hot wallet — docs/plan/open-questions.md 2026-09-06)
ARCNS_ADMIN=
# Treasury: receives fees and holds the genesis names (hot wallet on testnet, Treasury Safe on mainnet)
ARCNS_TREASURY=
# TimelockController minimum delay in seconds: 3600 on testnet, >= 172800 on mainnet (asserted by the script)
ARCNS_TIMELOCK_DELAY=
# uint256 salt nonce for SafeProxyFactory.createProxyWithNonce (same value => same Safe address on mainnet)
ARCNS_SAFE_SALT_NONCE=
# ---- market deploy (script/DeployMarket.s.sol, GrantMarketRole.s.sol, VerifyMarketRoles.s.sol — WP-124 / WP-7632,
#      docs/runbooks/market-deploy.md). All optional; the address-book path and the dry-run switch are shared by the
#      three phases, the ARCNS_MARKET_* values feed the CREATE2 init code (rehearse and broadcast with the SAME values).
# Path of the M1/M2 address book to read; default deployments/<chainId>.json (.dry-run.json when ARCNS_DRY_RUN=1).
# Set to deployments/5042002.json for a fork rehearsal against the live book.
ARCNS_ADDRESS_BOOK=
# 1 = never write the address book; phase 1 writes deployments/<chainId>.market-dry-run.json instead. Any run without
# --broadcast writes there regardless, so a rehearsal cannot touch deployments/5042002.json.
ARCNS_DRY_RUN=
# Market fee in bps (default 200 = 2 %), minimum bid increment in bps (default 500), anti-snipe window / extension in
# seconds (default 300 / 300), listing floor in whole USDC (default 1), NameLocks unlock timelock in seconds (default
# 604800 = 7 days; floored at 7 days on read, SR-14)
ARCNS_MARKET_FEE_BPS=
ARCNS_MARKET_MIN_INCREMENT_BPS=
ARCNS_MARKET_ANTI_SNIPE_WINDOW=
ARCNS_MARKET_ANTI_SNIPE_EXTEND=
ARCNS_MARKET_MIN_PRICE_USDC=
ARCNS_UNLOCK_TIMELOCK=
# Phase 4 (script/MarketInit.s.sol, read-only): path of the attestor/integrator config; default
# script/config/market-init.json. Must stay under script/config/ (the only config directory foundry.toml lets a script read).
ARCNS_MARKET_INIT_CONFIG=
# ---- genesis (tools/genesis --live only): hex private key of the GENESIS_ROLE holder (the deployer EOA)
ARCNS_GENESIS_KEY=
